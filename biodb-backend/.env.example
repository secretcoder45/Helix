ANTHROPIC_API_KEY=your_key_here

# Optional: free NCBI key raises the E-utilities rate limit from 3/sec to 10/sec
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional: defaults to local SQLite. Set to a Postgres URL in production
# (Railway provides one automatically as DATABASE_URL).
DATABASE_URL=
